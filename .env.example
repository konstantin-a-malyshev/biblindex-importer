# Copy this file to .env and fill in your BiblIndex API credentials.
# Request API credentials from your BiblIndex profile page.

# OAuth2 client of your API account (POST /api/token).
BIBLINDEX_CLIENT_ID=
BIBLINDEX_CLIENT_SECRET=

# Your biblindex.org login. With these set, the token is requested with the
# OAuth2 "password" grant, which BiblIndex API clients normally require.
# Left empty, the "client_credentials" grant is tried instead.
BIBLINDEX_USERNAME=
BIBLINDEX_PASSWORD=

BIBLINDEX_BASE_URL=https://www.biblindex.org

# Bible editions to export: "all" or ids like 8,4,2 (see `biblindex-import bibles`).
# Each quotation is indexed in the Bible its author quoted (8 = JB French,
# 4 = NTG Greek NT, 2 = Vulgate, ...), so "all" is needed for every quotation.
BIBLINDEX_BIBLE_ID=all

# Language of translated fields: en or fr.
BIBLINDEX_LOCALE=en

# Seconds between authenticated requests. The API allows 1 request/second
# per account; the small margin keeps us safely under it.
BIBLINDEX_MIN_INTERVAL=1.1

# Longest pause (seconds) taken because of X-RateLimit-Reset headers. BiblIndex
# announces ~8 s resets after every request but accepts 1 request/second, so
# trusting the header fully would make exports ~7x slower. 429 responses are
# always honoured in full regardless of this value.
BIBLINDEX_MAX_RESET_WAIT=2

# Seconds between anonymous requests to public reference data (books,
# authors, works). These are outside the rate-limit policy, but be polite.
BIBLINDEX_PUBLIC_MIN_INTERVAL=0.5

# Local cache of API responses; makes interrupted runs resumable.
BIBLINDEX_CACHE_PATH=.cache/biblindex.sqlite3
BIBLINDEX_CACHE_TTL_DAYS=30
